{
  "name": "formulr",
  "version": "0.1.0",
  "description": "Formulr: AI formulas for Excel (=FORMULR.ANSWER(B2)) on your own Cloudflare Worker, with your own AI key.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "scripts": {
    "knowledge": "node scripts/build-knowledge.mjs",
    "dev": "node scripts/build-knowledge.mjs && wrangler dev",
    "pretest": "node scripts/build-knowledge.mjs",
    "test": "node --test --test-reporter=spec \"test/*.test.mjs\"",
    "deploy": "node scripts/build-knowledge.mjs && wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "4.158.0"
  }
}
