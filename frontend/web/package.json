{
  "name": "formulr-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The Formulr install page. Built into ../public so the Worker serves it as static files.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir .ssr && node scripts/prerender.mjs",
    "test": "tsc --noEmit && node --test \"test/*.test.mjs\""
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.11",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "tailwindcss": "4.1.11",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
