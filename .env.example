# ============================================================
# FORMULR, settings map (committed, names only, never values).
# Copy to .env in this folder for the project wide settings, and
# backend/.env.example to backend/.env for the server's local secrets.
# Every .env file stays on your laptop; git ignores them.
# ============================================================

# --- Bring your own AI key
# Formulr never uses anyone else's key. Each person deploys their own copy with
# setup.cmd and their own Anthropic or Gemini key, which setup stores in their
# own Cloudflare account (not in any file).

# --- Server (backend/.env, read by Wrangler when running locally)
# APP_PASSWORD, ANTHROPIC_API_KEY, GEMINI_API_KEY, ADDIN_ID
# Database: Cloudflare D1 excel-ai-helper-quotas (linked by setup, no password)
# Local run: cd backend, npx wrangler dev, http://localhost:8787

# --- Claude chats that work on this project (ids, not secrets)
CLAUDE_SESSION_FORMULR_BUILDER=
