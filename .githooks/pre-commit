#!/usr/bin/env bash
# Botlien pre-commit secret check. Blocks a commit that contains a secret file
# or key-like text. It prints file names and the kind of match, never the value.
# Turn on once per clone:  git config core.hooksPath .githooks
# In an emergency (a false alarm) you can skip it with: git commit --no-verify
# but tell Antonio first, because that switches the protection off for that commit.
set -u
bad=0

# 1) File names that should never be committed
while IFS= read -r f; do
  case "$(basename "$f")" in
    .env|.env.*|.dev.vars|.dev.vars.*|*.pem|*.key|*.p12|*.pfx|.github_token|*credentials*|id_rsa*|*secret*.json)
      case "$f" in *.example|*example*|*.test.*|*/fixtures/*|*/test/*|*/tests/*) ;; *)
        echo "BLOCKED secret-type file: $f"; bad=1 ;; esac ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR)

# 2) Key-like text in the lines being added (skips tests and examples)
PAT='sk-ant-[A-Za-z0-9_-]{20,}|sk-[A-Za-z0-9]{32,}|AKIA[0-9A-Z]{16}|gh[pousr]_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{30,}|xox[baprs]-[A-Za-z0-9-]{20,}|AIza[0-9A-Za-z_-]{35}|re_[A-Za-z0-9]{8,}_[A-Za-z0-9]{16,}|BEGIN [A-Z ]*PRIVATE KEY|(api[_-]?key|token|secret|password|passwd)["'"'"']?[[:space:]]*[:=][[:space:]]*["'"'"'][A-Za-z0-9_+/-]{24,}["'"'"']|Bearer [A-Za-z0-9._-]{40,}'
for f in $(git diff --cached --name-only --diff-filter=ACMR); do
  case "$f" in *.test.*|*/test/*|*/tests/*|*/fixtures/*|*example*|*.lock|package-lock.json|*.png|*.jpg|*.mp4|*.pdf) continue ;; esac
  if git diff --cached -U0 -- "$f" | grep -E '^\+' | grep -vE '^\+\+\+' | grep -iEq "$PAT"; then
    echo "BLOCKED key-like text added in: $f"; bad=1
  fi
done

if [ "$bad" = 1 ]; then
  echo ""
  echo "Commit stopped. Move the value into the project's .env (never committed) and read it from there."
  exit 1
fi
exit 0
